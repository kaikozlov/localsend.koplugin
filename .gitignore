# Compiled gettext catalogs are never shipped; runtime reads .po directly.
*.mo

# i18n test fixtures: the localsend_i18n spec writes these throwaway fake-language
# catalogues beside the loader at setup and removes them at teardown. Listed here
# so a crashed test run can never leave them in the working tree.
lua/locale/zz.po
lua/locale/en_ZZ.po
lua/locale/z3.po
lua/locale/zc.po
lua/locale/z0.po
lua/locale/zi.po
lua/locale/zt.po
