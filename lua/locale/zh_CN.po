#: lua/_meta.lua lua/main.lua
msgid "LocalSend"
msgstr "LocalSend"

#: lua/_meta.lua lua/main.lua
msgid "Send and receive files using LocalSend protocol."
msgstr "使用 LocalSend 协议发送和接收文件。"

#: lua/localsend_diagnostics.lua
msgid "LAN connected"
msgstr "已连接局域网"

#: lua/localsend_diagnostics.lua
msgid "Enable Wi-Fi and connect to the same network as your other devices."
msgstr "请开启 Wi-Fi 并连接到与其他设备相同的网络。"

#: lua/localsend_diagnostics.lua
msgid "Receiver program present"
msgstr "接收程序已就位"

#: lua/localsend_diagnostics.lua
msgid ""
"The LocalSend receiver program is missing. Reinstall the plugin from Updates."
msgstr "找不到 LocalSend 接收程序，请通过「更新」重新安装插件。"

#: lua/localsend_diagnostics.lua
msgid "Receiver program runs"
msgstr "接收程序可运行"

#: lua/localsend_diagnostics.lua
msgid ""
"The receiver is installed but cannot run. Reinstall the package matching "
"this device and preserve executable permissions."
msgstr ""
"接收程序已安装但无法运行。请安装与本机匹配的软件包，解压时注意保留可执行权"
"限。"

#: lua/localsend_diagnostics.lua
msgid "Receiver package matches this device"
msgstr "接收程序与机型匹配"

#: lua/localsend_diagnostics.lua
msgid "package %1, device %2"
msgstr "软件包 %1，设备 %2"

#: lua/localsend_diagnostics.lua
msgid "Install the LocalSend package matching this device."
msgstr "请安装与本机匹配的 LocalSend 软件包。"

#: lua/localsend_diagnostics.lua
msgid "not configured"
msgstr "未配置"

#: lua/localsend_diagnostics.lua
msgid "Receive folder writable"
msgstr "接收目录可写入"

#: lua/localsend_diagnostics.lua
msgid "Choose an existing folder that KOReader can write to."
msgstr "请选择一个 KOReader 有写入权限的现有目录。"

#: lua/localsend_diagnostics.lua
msgid "Receiver self-test"
msgstr "接收程序自检"

#: lua/localsend_diagnostics.lua lua/main.lua
msgid "unknown"
msgstr "未知"

#: lua/localsend_diagnostics.lua
msgid ""
"The receiver did not start and answer on this device. Check the backend log "
"below."
msgstr "接收程序未在本机启动或未响应，请查看下方后台日志。"

#: lua/localsend_diagnostics.lua
msgid "Firewall"
msgstr "防火墙"

#: lua/localsend_diagnostics.lua
msgid "Firewall rules"
msgstr "防火墙规则"

#: lua/localsend_diagnostics.lua
msgid "The plugin could not open its firewall rules for port %1."
msgstr "插件无法为端口 %1 添加防火墙规则。"

#: lua/localsend_diagnostics.lua
msgid "Internet reachable (WebRTC)"
msgstr "可访问互联网（WebRTC）"

#: lua/localsend_diagnostics.lua
msgid "online"
msgstr "在线"

#: lua/localsend_diagnostics.lua
msgid ""
"WebRTC needs Internet access. Connect to the Internet or disable WebRTC for "
"LAN-only transfers."
msgstr "WebRTC 需要访问互联网。请连接互联网，或关闭 WebRTC 只做局域网传输。"

#: lua/localsend_diagnostics.lua
msgid "just now"
msgstr "刚刚"

#: lua/localsend_diagnostics.lua
msgid "%1 min ago"
msgstr "%1 分钟前"

#: lua/localsend_diagnostics.lua
msgid "Last send"
msgstr "上次发送"

#: lua/localsend_diagnostics.lua lua/localsend_sender.lua
msgid "OK"
msgstr "正常"

#: lua/localsend_diagnostics.lua
msgid "failed"
msgstr "失败"

#: lua/localsend_diagnostics.lua
msgid "A recent send failed. Use Transfer failed? for a focused explanation."
msgstr "最近一次发送失败。请用「传输失败？」查看具体原因。"

#: lua/localsend_diagnostics.lua
msgid "Result: all %1 check passed"
msgid_plural "Result: all %1 checks passed"
msgstr[0] "结果：全部 %1 项检查通过"

#: lua/localsend_diagnostics.lua
msgid "Result: %1 passed, %2 to fix"
msgstr "结果：%1 项通过，%2 项待修复"

#: lua/localsend_diagnostics.lua
msgid ""
"If another device still cannot find this one, choose “Can't find a device?”."
msgstr "如果其他设备仍找不到本机，请试试「找不到设备？」。"

#: lua/localsend_diagnostics.lua
msgid "Wi-Fi is not connected"
msgstr "Wi-Fi 未连接"

#: lua/localsend_diagnostics.lua
msgid ""
"Connect this device to the same Wi-Fi network as the phone or computer you "
"want to use."
msgstr "请将本机连接到与手机或电脑相同的 Wi-Fi 网络。"

#: lua/localsend_diagnostics.lua
msgid "Connect Wi-Fi"
msgstr "连接 Wi-Fi"

#: lua/localsend_diagnostics.lua
msgid "LocalSend needs to be reinstalled"
msgstr "需要重新安装 LocalSend"

#: lua/localsend_diagnostics.lua
msgid "The receiver program is missing from the plugin installation."
msgstr "插件安装中缺少接收程序。"

#: lua/localsend_diagnostics.lua lua/localsend_update.lua
msgid "Reinstall"
msgstr "重新安装"

#: lua/localsend_diagnostics.lua
msgid "The installed package does not work on this device"
msgstr "已安装的软件包无法在本机运行"

#: lua/localsend_diagnostics.lua
msgid ""
"Reinstall the LocalSend package that matches this device. Also preserve "
"executable permissions when extracting it."
msgstr "请重新安装与本机匹配的 LocalSend 软件包，解压时注意保留可执行权限。"

#: lua/localsend_diagnostics.lua
msgid "Files cannot be saved to the selected folder"
msgstr "无法保存到所选目录"

#: lua/localsend_diagnostics.lua
msgid ""
"Choose an existing folder that KOReader can write to, then try the transfer "
"again."
msgstr "请选择一个 KOReader 有写入权限的现有目录后重试传输。"

#: lua/localsend_diagnostics.lua
msgid "Choose folder"
msgstr "选择目录"

#: lua/localsend_diagnostics.lua
msgid "The LocalSend receiver could not start"
msgstr "LocalSend 接收程序无法启动"

#: lua/localsend_diagnostics.lua
msgid ""
"The receiver did not answer on this device. The backend log may explain why."
msgstr "接收程序未在本机响应，后台日志可能说明了原因。"

#: lua/localsend_diagnostics.lua
msgid "View log"
msgstr "查看日志"

#: lua/localsend_diagnostics.lua
msgid "LocalSend could not open its network port"
msgstr "LocalSend 无法打开网络端口"

#: lua/localsend_diagnostics.lua
msgid "This device could not allow LocalSend through its firewall on port %1."
msgstr "本机无法在端口 %1 上为 LocalSend 放行防火墙规则。"

#: lua/localsend_diagnostics.lua
msgid "View details"
msgstr "查看详情"

#: lua/localsend_diagnostics.lua
msgid "LocalSend is ready on this device"
msgstr "本机 LocalSend 已就绪"

#: lua/localsend_diagnostics.lua
msgid ""
"The receiver starts correctly and the save folder is writable. If another "
"device still cannot find this one, test device discovery next."
msgstr ""
"接收程序启动正常，保存目录可写入。如果其他设备仍找不到本机，请接着做设备发现"
"测试。"

#: lua/localsend_diagnostics.lua
msgid "Test discovery"
msgstr "测试设备发现"

#: lua/localsend_diagnostics.lua
msgid ""
"This disables encrypted LocalSend transfers until you turn HTTPS back on in "
"Settings. The receiver will restart."
msgstr ""
"关闭后将不再加密 LocalSend 传输，直到你在设置里重新开启 HTTPS。接收程序会重"
"启。"

#: lua/localsend_diagnostics.lua
msgid "Disable HTTPS"
msgstr "关闭 HTTPS"

#: lua/localsend_diagnostics.lua
msgid ""
"Open LocalSend Settings and review Allowed extensions and File type routing."
msgstr "请打开 LocalSend 设置，检查「允许的扩展名」和「按文件类型分目录」。"

#: lua/localsend_diagnostics.lua lua/main.lua
msgid "Technical details"
msgstr "技术详情"

#: lua/localsend_diagnostics.lua lua/main.lua
msgid "Close"
msgstr "关闭"

#: lua/localsend_diagnostics.lua
msgid "LocalSend check"
msgstr "LocalSend 检查"

#: lua/localsend_diagnostics.lua
msgid "Checking LocalSend…"
msgstr "正在检查 LocalSend…"

#: lua/localsend_diagnostics.lua
msgid "LocalSend diagnostics"
msgstr "LocalSend 诊断"

#: lua/localsend_diagnostics.lua
msgid "Collecting technical details…"
msgstr "正在收集技术信息…"

#: lua/localsend_diagnostics.lua
msgid "Could not retrieve network info."
msgstr "无法获取网络信息。"

#: lua/localsend_diagnostics.lua
msgid "LocalSend backend log"
msgstr "LocalSend 后台日志"

#: lua/localsend_diagnostics.lua
msgid "No backend log found."
msgstr "未找到后台日志。"

#: lua/localsend_diagnostics.lua
msgid ""
"When reporting a LocalSend issue, please include:\n"
"\n"
"• Device model and firmware\n"
"• KOReader version\n"
"• LocalSend plugin version\n"
"• Sender app/version\n"
"• Steps to reproduce\n"
"• KOReader crash.log\n"
"• The diagnostics report below\n"
"\n"
"Review the report before posting publicly — it can include device names, "
"file names, and network addresses.\n"
"\n"
"%1"
msgstr ""
"反馈 LocalSend 问题时，请附上：\n"
"\n"
"• 设备型号与固件\n"
"• KOReader 版本\n"
"• LocalSend 插件版本\n"
"• 发送端应用/版本\n"
"• 复现步骤\n"
"• KOReader 的 crash.log\n"
"• 下方的诊断报告\n"
"\n"
"公开发布前请先检查报告——其中可能包含设备名、文件名和网络地址。\n"
"\n"
"%1"

#: lua/localsend_diagnostics.lua
msgid "Copy report"
msgstr "复制报告"

#: lua/localsend_diagnostics.lua
msgid "Support report copied"
msgstr "支持报告已复制"

#: lua/localsend_diagnostics.lua
msgid "LocalSend support report"
msgstr "LocalSend 支持报告"

#: lua/localsend_diagnostics.lua
msgid "Creating support report…"
msgstr "正在生成支持报告…"

#: lua/localsend_diagnostics.lua
msgid "The receiving device could not save the file"
msgstr "接收设备无法保存该文件"

#: lua/localsend_diagnostics.lua
msgid ""
"Its storage may be full, unavailable, or read-only. Check free space or "
"choose another receive folder."
msgstr "对方存储可能已满、不可用或只读。请检查剩余空间，或换一个接收目录。"

#: lua/localsend_diagnostics.lua
msgid "The receiving device rejected this file"
msgstr "接收设备拒绝了该文件"

#: lua/localsend_diagnostics.lua
msgid ""
"Review Allowed extensions and File type routing on the receiving device."
msgstr "请在接收设备上检查「允许的扩展名」和「按文件类型分目录」。"

#: lua/localsend_diagnostics.lua
msgid "Review settings"
msgstr "查看设置"

#: lua/localsend_diagnostics.lua
msgid "The PIN was not accepted"
msgstr "PIN 未通过验证"

#: lua/localsend_diagnostics.lua
msgid "Enter the PIN shown by the receiving device and try again."
msgstr "请输入接收设备上显示的 PIN 后重试。"

#: lua/localsend_diagnostics.lua
msgid "The secure connection failed"
msgstr "加密连接失败"

#: lua/localsend_diagnostics.lua
msgid ""
"The devices could not establish an HTTPS connection. You can temporarily "
"test without HTTPS."
msgstr "两台设备无法建立 HTTPS 连接。可以先临时关闭 HTTPS 试一次。"

#: lua/localsend_diagnostics.lua
msgid "Try without HTTPS"
msgstr "不用 HTTPS 试一次"

#: lua/localsend_diagnostics.lua
msgid "The other device is not reachable"
msgstr "无法连接到对方设备"

#: lua/localsend_diagnostics.lua
msgid ""
"Make sure LocalSend is open on the other device and both devices are "
"connected to the same Wi-Fi network."
msgstr "请确认对方设备已打开 LocalSend，并且两台设备在同一 Wi-Fi 网络。"

#: lua/localsend_diagnostics.lua
msgid "Find devices"
msgstr "查找设备"

#: lua/localsend_diagnostics.lua
msgid "The connection ended during the transfer"
msgstr "传输过程中连接中断"

#: lua/localsend_diagnostics.lua
msgid ""
"Keep both devices awake and connected to Wi-Fi, then retry. If it happens "
"again, create a support report immediately afterward."
msgstr ""
"请让两台设备保持唤醒并连着 Wi-Fi 后重试。若再次发生，请立即生成支持报告。"

#: lua/localsend_diagnostics.lua
msgid "Create report"
msgstr "生成报告"

#: lua/localsend_diagnostics.lua
msgid "The received file did not pass verification"
msgstr "接收的文件未通过校验"

#: lua/localsend_diagnostics.lua
msgid ""
"The transfer was incomplete or corrupted. Retry it while both devices have a "
"stable Wi-Fi connection."
msgstr "传输不完整或已损坏。请在两台设备 Wi-Fi 稳定时重试。"

#: lua/localsend_diagnostics.lua
msgid "The receiving device rejected the transfer"
msgstr "接收设备拒绝了本次传输"

#: lua/localsend_diagnostics.lua
msgid ""
"The available logs do not identify a safe automatic fix. Create a support "
"report immediately after reproducing the failure."
msgstr ""
"现有日志无法判断出安全可行的自动修复方式。请在复现失败后立即生成支持报告。"

#: lua/localsend_diagnostics.lua
msgid "No recent transfer error was recognized"
msgstr "未识别到最近的传输错误"

#: lua/localsend_diagnostics.lua
msgid ""
"Try the transfer once more, then return here immediately. A support report "
"will include the newest LocalSend logs."
msgstr "请再传一次，之后立刻回到这里。支持报告会包含最新的 LocalSend 日志。"

#: lua/localsend_diagnostics.lua
msgid "Testing the LocalSend receiver…"
msgstr "正在测试 LocalSend 接收程序…"

#: lua/localsend_diagnostics.lua
msgid "Transfer failed"
msgstr "传输失败"

#: lua/localsend_diagnostics.lua
msgid ""
"Open LocalSend on your phone or computer and keep it visible during the "
"test. Both devices should be connected to the same Wi-Fi network. The "
"receiver will keep running if it is enabled."
msgstr ""
"请在你的手机或电脑上打开 LocalSend 并保持在前台，两台设备需在同一 Wi-Fi 网"
"络。若接收程序已启用，测试后仍会继续运行。"

#: lua/localsend_diagnostics.lua
msgid "Start test"
msgstr "开始测试"

#: lua/localsend_diagnostics.lua
msgid "Device discovery failed"
msgstr "设备发现失败"

#: lua/localsend_diagnostics.lua
msgid "Another LocalSend device was found"
msgstr "找到了另一台 LocalSend 设备"

#: lua/localsend_diagnostics.lua
msgid "Device discovery is working. Found: %1"
msgstr "设备发现正常。找到：%1"

#: lua/localsend_diagnostics.lua
msgid "No other LocalSend device answered"
msgstr "没有其他 LocalSend 设备响应"

#: lua/localsend_diagnostics.lua
msgid ""
"No devices responded during this scan. Keep LocalSend open on the other "
"device and check its firewall or Local Network permission. This result alone "
"does not show a network failure."
msgstr ""
"本次扫描没有设备响应。请让对端保持 LocalSend 打开，并检查其防火墙或「本地网"
"络」权限。仅凭这一结果不能断定网络故障。"

#: lua/localsend_diagnostics.lua
msgid "Device discovery"
msgstr "设备发现"

#: lua/localsend_diagnostics.lua lua/main.lua
msgid "Discovery details"
msgstr "发现详情"

#: lua/localsend_diagnostics.lua
msgid "No discovery details are available."
msgstr "没有可用的发现详情。"

#: lua/localsend_diagnostics.lua
msgid "The localsend binary is missing. Reinstall the plugin first."
msgstr "缺少 localsend 程序，请先重新安装插件。"

#: lua/localsend_dialogs.lua
msgid "All files"
msgstr "所有文件"

#: lua/localsend_dialogs.lua
msgid "eBooks (epub, pdf, mobi, azw3)"
msgstr "电子书（epub、pdf、mobi、azw3）"

#: lua/localsend_dialogs.lua
msgid "eBooks + CBZ (comics)"
msgstr "电子书 + CBZ（漫画）"

#: lua/localsend_dialogs.lua
msgid "PDF only"
msgstr "仅 PDF"

#: lua/localsend_dialogs.lua
msgid "EPUB only"
msgstr "仅 EPUB"

#: lua/localsend_dialogs.lua lua/localsend_routing.lua
msgid "Custom..."
msgstr "自定义…"

#: lua/localsend_dialogs.lua lua/localsend_routing.lua
msgid "Cannot use this directory: %1"
msgstr "无法使用该目录：%1"

#: lua/localsend_dialogs.lua
msgid "Device name"
msgstr "设备名"

#: lua/localsend_dialogs.lua
msgid "Leave empty for default ('KOReader')"
msgstr "留空则使用默认（「KOReader」）"

#: lua/localsend_dialogs.lua lua/localsend_discovery.lua
#: lua/localsend_routing.lua lua/localsend_sender.lua lua/localsend_update.lua
#: lua/main.lua
msgid "Cancel"
msgstr "取消"

#: lua/localsend_dialogs.lua
msgid "Save"
msgstr "保存"

#: lua/localsend_dialogs.lua lua/localsend_sender.lua
msgid "PIN code"
msgstr "PIN 码"

#: lua/localsend_dialogs.lua
msgid "Leave empty to disable PIN protection"
msgstr "留空则不启用 PIN 保护"

#: lua/localsend_dialogs.lua
msgid "Custom extensions"
msgstr "自定义扩展名"

#: lua/localsend_dialogs.lua
msgid "Comma-separated list (e.g., 'epub,pdf,mobi')"
msgstr "用英文逗号分隔（例如「epub,pdf,mobi」）"

#: lua/localsend_discovery.lua
msgid "Another discovery scan is in progress."
msgstr "另一个设备发现扫描正在进行。"

#: lua/localsend_discovery.lua
msgid "Failed to launch device discovery."
msgstr "启动设备发现失败。"

#: lua/localsend_discovery.lua
msgid "Device discovery timed out."
msgstr "设备发现超时。"

#: lua/localsend_discovery.lua
msgid "Device discovery failed."
msgstr "设备发现失败。"

#: lua/localsend_discovery.lua
msgid "No devices found"
msgstr "未找到设备"

#: lua/localsend_discovery.lua
msgid "Make sure LocalSend is running on the target device."
msgstr "请确认目标设备上的 LocalSend 正在运行。"

#: lua/localsend_discovery.lua lua/localsend_sender.lua
msgid "Scan again"
msgstr "重新扫描"

#: lua/localsend_discovery.lua
msgid "No devices found. Make sure LocalSend is running on the target device."
msgstr "未找到设备。请确认目标设备上的 LocalSend 正在运行。"

#: lua/localsend_discovery.lua
msgid "Select target device"
msgstr "选择目标设备"

#: lua/localsend_discovery.lua
msgid "Scanning for devices..."
msgstr "正在扫描设备…"

#: lua/localsend_routing.lua
msgid "Select extension to route"
msgstr "选择要分目录的扩展名"

#: lua/localsend_routing.lua
msgid "Extension to route"
msgstr "要分目录的扩展名"

#: lua/localsend_routing.lua
msgid "Enter file extension (without dot)"
msgstr "输入文件扩展名（不含点）"

#: lua/localsend_routing.lua
msgid "Next"
msgstr "下一步"

#: lua/localsend_routing.lua
msgid "Select directory for .%1 files"
msgstr "选择 .%1 文件的目录"

#: lua/localsend_routing.lua
msgid ""
".%1 files will be saved to:\n"
"%2"
msgstr ""
".%1 文件将保存到：\n"
"%2"

#: lua/localsend_routing.lua
msgid "Enable file type routing"
msgstr "启用按文件类型分目录"

#: lua/localsend_routing.lua
msgid ""
"When enabled, files are routed to directories based on extension. When "
"disabled, all files go to the main save directory."
msgstr "启用后按扩展名把文件分到不同目录；关闭则全部存到主保存目录。"

#: lua/localsend_routing.lua
msgid ".%1 → %2"
msgstr ".%1 → %2"

#: lua/localsend_routing.lua
msgid "Route for .%1"
msgstr ".%1 的目录"

#: lua/localsend_routing.lua
msgid "Change directory"
msgstr "更换目录"

#: lua/localsend_routing.lua
msgid "Remove route"
msgstr "删除规则"

#: lua/localsend_routing.lua
msgid "Route for .%1 removed"
msgstr "已删除 .%1 的规则"

#: lua/localsend_routing.lua
msgid "Add extension route..."
msgstr "添加扩展名规则…"

#: lua/localsend_routing.lua
msgid "Accept other files → main directory"
msgstr "接受其他文件 → 主目录"

#: lua/localsend_routing.lua
msgid ""
"When enabled, files without a specific route are saved to the main save "
"directory. When disabled, only routed file types are accepted."
msgstr ""
"启用后，没有单独规则的文件会存到主保存目录；关闭则只接受已配置规则的文件类"
"型。"

#: lua/localsend_sender.lua
msgid "Another send operation is in progress"
msgstr "另一个发送任务正在进行"

#: lua/localsend_sender.lua
msgid "File does not exist"
msgstr "文件不存在"

#: lua/localsend_sender.lua
msgid "Failed to start send process"
msgstr "启动发送进程失败"

#: lua/localsend_sender.lua
msgid "Send in progress"
msgstr "正在发送"

#: lua/localsend_sender.lua
msgid "Sending %1 to %2..."
msgstr "正在发送 %1 到 %2…"

#: lua/localsend_sender.lua
msgid "Cancelling send..."
msgstr "正在取消发送…"

#: lua/localsend_sender.lua
msgid "Cancelled"
msgstr "已取消"

#: lua/localsend_sender.lua
msgid "Send cancelled"
msgstr "发送已取消"

#: lua/localsend_sender.lua
msgid "Sent %1 to %2"
msgstr "已将 %1 发送到 %2"

#: lua/localsend_sender.lua
msgid "Transfer was rejected by the recipient"
msgstr "传输被接收方拒绝"

#: lua/localsend_sender.lua
msgid "PIN required"
msgstr "需要 PIN"

#: lua/localsend_sender.lua
msgid "Device is not running LocalSend"
msgstr "对方设备未运行 LocalSend"

#: lua/localsend_sender.lua
msgid "Too many failed attempts - try again later"
msgstr "失败次数过多，请稍后再试"

#: lua/localsend_sender.lua
