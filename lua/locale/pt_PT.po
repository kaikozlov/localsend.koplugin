#: lua/localsend_diagnostics.lua:1211
msgid ""
"Reinstall the LocalSend package that matches this device. Also preserve "
"executable permissions when extracting it."
msgstr ""
"Reinstale o pacote do LocalSend correspondente a este dispositivo. Mantenha "
"também as permissões de execução ao extraí-lo."

#: lua/localsend_diagnostics.lua:1219
