#!/bin/bash
#
# Pre-commit hook for localsend.koplugin
# Runs formatting, linting, and tests via koplugin-dev Docker container
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "=============================================="
echo "  Pre-commit checks"
echo "=============================================="
echo

FAILED=0

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
STAGED_LUA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.lua$' || true)

# ----------------------------------------------
# Go Formatting - Auto-fix and re-stage
# ----------------------------------------------
if [ -n "$STAGED_GO_FILES" ]; then
    echo -e "${YELLOW}Formatting Go files...${NC}"
    for file in $STAGED_GO_FILES; do
        if [ -f "$file" ]; then
            gofmt -w "$file"
            git add "$file"
        fi
    done
    echo -e "${GREEN}✓ Go formatting applied${NC}"
    echo
fi

# ----------------------------------------------
# Run full test suite via Docker (if code changed)
# ----------------------------------------------
if [ -n "$STAGED_GO_FILES" ] || [ -n "$STAGED_LUA_FILES" ]; then
    echo -e "${YELLOW}Running test suite (make test)...${NC}"
    if make test; then
        echo -e "${GREEN}✓ All tests passed${NC}"
    else
        echo -e "${RED}✗ Tests failed${NC}"
        FAILED=1
    fi
    echo
fi

# ----------------------------------------------
# Check for common issues
# ----------------------------------------------
echo -e "${YELLOW}Checking for common issues...${NC}"

DEBUG_PRINTS=$(git diff --cached | grep -E '^\+.*fmt\.(Println|Printf)\(' | grep -v '_test\.go' || true)
if [ -n "$DEBUG_PRINTS" ]; then
    echo -e "${YELLOW}⚠ Warning: Found new fmt.Println/Printf (may be intentional):${NC}"
    echo "$DEBUG_PRINTS"
fi

TODOS=$(git diff --cached -- '*.go' '*.lua' | grep -E '^\+.*\b(TODO|FIXME|XXX)\b' || true)
if [ -n "$TODOS" ]; then
    echo -e "${YELLOW}⚠ New TODO/FIXME comments found:${NC}"
    echo "$TODOS"
fi

echo -e "${GREEN}✓ Common issues check complete${NC}"
echo

# ----------------------------------------------
# Summary
# ----------------------------------------------
echo "=============================================="
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}  All pre-commit checks passed!${NC}"
else
    echo -e "${RED}  Pre-commit checks failed${NC}"
    echo -e "${RED}  Commit aborted. Fix the issues above and try again.${NC}"
fi
echo "=============================================="

exit $FAILED
