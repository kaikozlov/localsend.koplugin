#!/usr/bin/env bash
#
# Fast, read-only checks for the commit loop. Full tests run before push and in CI.
#

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-commit] Running read-only formatting, lint, and i18n checks..."
just verify-static
echo "[pre-commit] Static checks passed."
