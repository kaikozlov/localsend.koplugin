#!/usr/bin/env bash
#
# Pre-commit hook for localsend.koplugin
# Formats, lints, and tests in a single koplugin-dev container
#

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Remember staged paths so we can re-stage after auto-format without
# accidentally adding unrelated untracked files.
staged_files="$(git diff --cached --name-only --diff-filter=ACM || true)"

echo "[pre-commit] Running just check (fmt + lint + test)..."
just check

# Re-stage previously staged files that still exist (picks up formatter edits).
if [ -n "$staged_files" ]; then
    while IFS= read -r file; do
        if [ -n "$file" ] && [ -f "$file" ]; then
            git add -- "$file"
        fi
    done <<<"$staged_files"
fi

echo "[pre-commit] Checks passed."
